# ─────────────────────────────────────────────────────────────────
# NAGARNETRA — Environment Configuration
# Copy this file to .env and edit values before running.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# DB_MODE: "sqlite" (zero-setup, recommended for local demo)
#          "postgres" (requires running PostgreSQL + PostGIS)
DB_MODE=sqlite

# SQLite path (only used when DB_MODE=sqlite)
SQLITE_PATH=./data/nagarnetra.db

# PostgreSQL config (only used when DB_MODE=postgres)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=nagarnetra
POSTGRES_PASSWORD=nagarnetra_pass
POSTGRES_DB=nagarnetra
DATABASE_URL=postgresql+asyncpg://nagarnetra:nagarnetra_pass@db:5432/nagarnetra

# ── Service Ports ─────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── ANPR Pipeline ─────────────────────────────────────────────────
# Path to YOLOv8 weights. If the file doesn't exist, falls back to yolov8n pretrained.
# Drop a fine-tuned ANPR model here (e.g. best.pt from training) to replace default.
YOLO_WEIGHTS_PATH=./models/best.pt

# How many frames to skip between detections (1 = every frame, 5 = every 5th frame)
FRAME_SAMPLE_RATE=5

# Minimum YOLO confidence to accept a plate detection
DETECTION_CONFIDENCE_THRESHOLD=0.4

# Minimum PaddleOCR confidence to accept a plate read
OCR_CONFIDENCE_THRESHOLD=0.6

# ── Ingestion ─────────────────────────────────────────────────────
# Directory where camera video files live (filenames must match camera_id, e.g. cam_01.mp4)
VIDEOS_DIR=./data/sample_videos

# Path to cameras registry JSON
CAMERAS_JSON_PATH=./data/cameras.json

# Path to blacklist JSON
BLACKLIST_JSON_PATH=./data/blacklist.json

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
