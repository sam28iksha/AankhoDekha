# ─────────────────────────────────────────────────────────────────
# AANKHODEKHA — Environment Configuration
# Copy this file to .env and edit values before running.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# DB_MODE: "sqlite" (zero-setup, recommended for local demo)
#          "postgres" (requires running PostgreSQL + PostGIS)
DB_MODE=postgres

# SQLite path (only used when DB_MODE=sqlite)
SQLITE_PATH=./data/aankhodekha.db

# PostgreSQL config (only used when DB_MODE=postgres)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=aankhodekha
POSTGRES_PASSWORD=aankhodekha_pass
POSTGRES_DB=aankhodekha
DATABASE_URL=postgresql+asyncpg://aankhodekha:aankhodekha_pass@db:5432/aankhodekha

# ── Service Ports ─────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Map Tiles ─────────────────────────────────────────────────────
# MapTiler custom style, built with "Preferred country borders: India"
# so Jammu & Kashmir/Ladakh render per India's official depiction instead
# of the default OpenStreetMap disputed-border convention. This key is
# client-visible by design (embedded in a browser tile URL) — restrict it
# to your domain(s) in the MapTiler dashboard rather than treating it as
# a secret. Shared across the team so everyone sees the same corrected map.
VITE_MAPTILER_KEY=KXVlZpvSDsmbvczfF0aU
VITE_MAPTILER_STYLE_ID=01a09471-e40d-74ac-b437-32d34209fd25

# ── ANPR Pipeline ─────────────────────────────────────────────────
# Path to YOLOv8 weights. If the file doesn't exist, falls back to yolov8n pretrained.
# Drop a fine-tuned ANPR model here (e.g. best.pt from training) to replace default.
YOLO_WEIGHTS_PATH=./models/best.pt

# How many frames to skip between detections (1 = every frame, 5 = every 5th frame)
FRAME_SAMPLE_RATE=5

# Minimum YOLO confidence to accept a plate detection
DETECTION_CONFIDENCE_THRESHOLD=0.4

# Minimum PaddleOCR confidence to accept a plate read
OCR_CONFIDENCE_THRESHOLD=0.6

# ── Ingestion ─────────────────────────────────────────────────────
# Directory where camera video files live (filenames must match camera_id, e.g. cam_01.mp4)
VIDEOS_DIR=./data/sample_videos

# Path to cameras registry JSON
CAMERAS_JSON_PATH=./data/cameras.json

# Path to blacklist JSON
BLACKLIST_JSON_PATH=./data/blacklist.json

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth / RBAC ───────────────────────────────────────────────────
# Signing key for login tokens. If left blank, a random one is generated
# each time the backend starts — safe, but every logged-in session is
# invalidated on restart. Set a stable value here for anything beyond a
# single local demo session (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=

# How long a login stays valid before needing to sign in again.
JWT_EXPIRE_MINUTES=480

# Bootstrap admin account, seeded once on first startup if no users exist
# yet. Log in and change the password afterward — this only exists to
# solve "how do I log in the first time."
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=aankhodekha_admin
